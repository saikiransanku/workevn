{
  "name": "workven",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open /index.html",
    "dev:customer": "vite --open /index.html",
    "dev:partner": "vite --open /partner.html",
    "dev:admin": "vite --open /admin.html",
    "dev:backend": "node backend/server.js",
    "dev:admin:api": "node backend/server.js",
    "build": "vite build",
    "build:customer": "vite build --mode customer --outDir dist",
    "build:partner": "vite build --mode partner --outDir dist-partner",
    "build:admin": "vite build --mode admin --outDir dist-admin",
    "admin:api": "node backend/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:partner": "vite preview --outDir dist-partner",
    "preview:admin": "vite preview --outDir dist-admin"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
